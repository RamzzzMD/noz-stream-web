{
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index.js" },
    { "source": "/", "destination": "/frontend/index.html" },
    { "source": "/browse", "destination": "/frontend/browse.html" },
    { "source": "/search", "destination": "/frontend/search.html" },
    { "source": "/video", "destination": "/frontend/video.html" },
    { "source": "/:path*", "destination": "/frontend/:path*" }
  ]
}
